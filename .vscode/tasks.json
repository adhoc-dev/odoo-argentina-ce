{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Pre-commit: Archivo actual",
      "type": "shell",
      "command": "python3 -m pre_commit run --files ${file}",
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      }
    },
    {
      "label": "Pre-commit: Todos los archivos",
      "type": "shell",
      "command": "python3 -m pre_commit run --all-files",
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      }
    },
    {
      "label": "Verificar PR listo",
      "type": "shell",
      "command": "./check_pr_ready.sh",
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "new"
      }
    },
    {
      "label": "Pylint: Archivo actual",
      "type": "shell",
      "command": "pylint ${file}",
      "problemMatcher": {
        "owner": "python",
        "fileLocation": ["relative", "${workspaceFolder}"],
        "pattern": {
          "regexp": "^(.+):(\\d+):(\\d+):\\s+(\\w+)\\((\\w+)\\):\\s+(.+)$",
          "file": 1,
          "line": 2,
          "column": 3,
          "severity": 4,
          "code": 5,
          "message": 6
        }
      }
    }
  ]
}
