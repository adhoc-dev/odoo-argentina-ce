<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="mipymepartner_form" model="ir.ui.view">
        <field name="name">mipymepartner.form</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="account.view_partner_property_form"/>
        <field name="arch" type="xml">
            <group name="general" position="after">
                <group name="miPyme" string="Mi pyme">
                    <field name="mipyme_required"/>
                    <field name="mipyme_from_amount" invisible="not mipyme_required"/>
                    <button name="l10n_ar_fiscal_ws_fe_min_ammount" string="Check mi Pyme status" type="object"/>
                </group>
            </group>
        </field>
    </record>
    <record id="view_partner_form" model="ir.ui.view">
        <field name="name">res.partner.form</field>
        <field name="model">res.partner</field>
        <field eval="90" name="priority"/>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <div name="button_box" position="inside">
                <button class="oe_stat_button" icon="fa-rss" name="update_from_padron_arca" type="object">
                    <div class="o_form_field o_stat_info">
                        <span class="o_stat_value">ARCA A5</span>
                        <span class="o_stat_text"><field name="last_update_census" readonly="True"/></span>
                    </div>
                </button>
            </div>
        </field>
    </record>
    <record id="action_update_from_padron_mass" model="ir.actions.server">
        <field name="name">Actualizar desde Padrón ARCA</field>
        <field name="model_id" ref="base.model_res_partner"/>
        <field name="binding_model_id" ref="base.model_res_partner"/>
        <field name="binding_view_types">list</field>
        <field name="state">code</field>
        <field name="code">action = records.action_update_from_padron_mass()</field>
    </record>
</odoo>
