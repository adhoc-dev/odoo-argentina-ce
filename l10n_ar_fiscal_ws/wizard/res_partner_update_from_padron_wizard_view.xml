<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="action_base_partner_update_from_padron" model="ir.actions.act_window">
        <field name="name">Update Partners From Padron ARCA</field>
        <field name="res_model">res.partner.update.from.padron.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
    <menuitem action="action_base_partner_update_from_padron" groups="base.group_system" id="menu_base_partner_update_from_padron" parent="contacts.res_partner_menu_config"/>
    <record id="view_base_partner_update_from_padron_form" model="ir.ui.view">
        <field name="name">res.partner.update.from.padron.wizard.form</field>
        <field name="model">res.partner.update.from.padron.wizard</field>
        <field name="arch" type="xml">
            <form string="Actualización Automática desde ARCA">
                <field invisible="1" name="state"/>
                <field invisible="1" name="has_afip_error"/>
                <header/>
                <sheet>
                    <!-- Estado: Finalizado -->
                    <div invisible="state != 'finished'" class="alert alert-success text-center" role="status">
                        <h3>
                            <i class="fa fa-check-circle"/> Actualización completada
                        </h3>
                        <p class="mb-0">No hay más partners para actualizar en esta solicitud.</p>
                    </div>

                    <!-- Estado: Configuración inicial -->
                    <group invisible="state != 'option'">
                        <div class="alert alert-info" role="alert">
                            <p class="mb-0">
                                <i class="fa fa-info-circle"/> Solo se actualizarán los contactos con CUIT válido.
                                <br/>Seleccione los campos que desea actualizar desde ARCA.
                            </p>
                        </div>
                        <group>
                            <field name="field_to_update_ids"
                                   string="Campos a Actualizar"
                                   options="{'no_create': True}"
                                   widget="many2many_tags"/>
                            <field name="update_constancia" string="Actualizar Constancia"/>
                            <field name="title_case" string="Formato Título"/>
                        </group>
                    </group>

                    <!-- Estado: Revisión de cambios -->
                    <group invisible="state in ('option', 'finished')">
                        <!-- Header con partner -->
                        <group col="2" colspan="2">
                            <group>
                                <label for="partner_id" string="Contacto a actualizar"/>
                                <field name="partner_id"
                                       required="state == 'selection'"
                                       options="{'no_open': True}"
                                       nolabel="1"/>
                            </group>
                        </group>

                        <!-- Mensaje de advertencia -->
                        <group colspan="2" invisible="not has_afip_error">
                            <div class="alert alert-warning" role="alert">
                                <i class="fa fa-exclamation-triangle"/>
                                Revise los cambios propuestos. Puede editar los valores antes de aplicar.
                            </div>
                        </group>

                        <!-- Tabla de cambios -->
                        <group colspan="2" invisible="has_afip_error">
                            <separator string="Cambios Propuestos desde ARCA" colspan="2"/>
                            <field name="field_ids" nolabel="1" colspan="2">
                                <list create="false" editable="bottom">
                                    <field name="field" column_invisible="1"/>
                                    <field name="field_label" string="Campo" readonly="1"/>
                                    <field name="old_value" string="Valor Actual" readonly="1"/>
                                    <field name="new_value" string="Nuevo Valor (ARCA)"/>
                                </list>
                            </field>
                        </group>

                        <!-- Mostrar error de AFIP -->
                        <group colspan="2" invisible="not has_afip_error">
                            <div class="alert alert-danger" role="alert">
                                <h5><i class="fa fa-exclamation-triangle"/> Error de AFIP</h5>
                                <field name="afip_error" nolabel="1" readonly="1" widget="text" class="text-danger"/>
                                <p class="mt-2 text-muted">
                                    <i class="fa fa-info-circle"/>
                                    Este error proviene directamente del servidor de AFIP.
                                    Verifique el CUIT en el sitio web de AFIP o contacte al administrador del sistema.
                                </p>
                            </div>
                        </group>

                        <!-- Información de debugging XML -->
                        <notebook colspan="2" invisible="not xml_request or has_afip_error" groups="base.group_system">
                            <page string="XML Enviado a ARCA">
                                <field name="xml_request" widget="ace" options="{'mode': 'xml'}" nolabel="1"/>
                            </page>
                            <page string="XML Recibido de ARCA">
                                <field name="xml_response" widget="ace" options="{'mode': 'xml'}" nolabel="1"/>
                            </page>
                        </notebook>

                        <!-- Mensaje de estado -->
                        <group colspan="2" invisible="not field_ids or has_afip_error">
                            <div class="alert alert-success" role="alert">
                                <i class="fa fa-check-circle"/> Se detectaron cambios. Revise antes de aplicar.
                            </div>
                        </group>
                        <group colspan="2" invisible="field_ids or has_afip_error">
                            <div class="alert alert-info" role="alert">
                                <i class="fa fa-info-circle"/> No hay cambios. Los datos coinciden con ARCA.
                            </div>
                        </group>
                    </group>
                </sheet>
                <footer>
                    <!-- Botones para estado 'selection' -->
                    <button invisible="state in ('option', 'finished') or has_afip_error"
                            class="btn-primary"
                            name="update_selection"
                            string="Aplicar Cambios"
                            type="object"
                            icon="fa-check"/>
                    <button invisible="state != 'selection'"
                            name="next_cb"
                            string="Omitir este contacto"
                            type="object"
                            icon="fa-forward"/>

                    <!-- Botones para estado 'option' -->
                    <button invisible="state != 'option'"
                            class="btn-primary"
                            name="start_process_cb"
                            string="Actualizar con Revisión Manual"
                            type="object"
                            icon="fa-edit"/>
                    <button invisible="state != 'option'"
                            class="btn-success"
                            confirm="¿Está seguro de ejecutar la actualización automática de todos sus contactos?"
                            name="automatic_process_cb"
                            string="Actualizar Automáticamente"
                            type="object"
                            icon="fa-bolt"/>

                    <!-- Botones de cancelar/cerrar -->
                    <button invisible="state == 'finished'"
                            special="cancel"
                            string="Cancelar"
                            class="btn-secondary"/>
                    <button invisible="state != 'finished'"
                            special="cancel"
                            string="Cerrar"
                            class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
    <record id="action_partner_update" model="ir.actions.act_window">
        <field name="name">Automatic Update from Padron</field>
        <field name="res_model">res.partner.update.from.padron.wizard</field>
        <field name="target">new</field>
        <field name="view_mode">form</field>
    </record>
</odoo>
