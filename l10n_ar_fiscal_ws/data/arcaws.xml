<odoo>
    <record id="arca_login_cms" model="arcaws">
        <field name="name">Afip LoginCms</field>
        <field name="code">LoginCms</field>
        <field name="ws_parameters" eval="{'dummy_method': False}"></field>
        <field name="production_url">https://wsaa.afip.gov.ar/ws/services/LoginCms?wsdl</field>
        <field name="homologation_url">https://wsaahomo.afip.gov.ar/ws/services/LoginCms?wsdl</field>
    </record>

    <record id="arca_padron_a5" model="arcaws">
        <field name="name">Constancia de Inscripción</field>
        <field name="code">ws_sr_constancia_inscripcion</field>
        <field name="ws_parameters" eval="{'dummy_method': 'dummy'}"></field>
        <field name="production_url">https://aws.afip.gov.ar/sr-padron/webservices/personaServiceA5?WSDL</field>
        <field name="homologation_url">https://awshomo.afip.gov.ar/sr-padron/webservices/personaServiceA5?WSDL</field>
    </record>


    <!-- ============================================ -->
    <!-- MÉTODOS: Constancia de Inscripción (Padrón A5) -->
    <!-- ============================================ -->

    <!-- Método dummy para testing de conexión -->
    <record id="arca_constancia_inscripcion_method_dummy" model="arcaws.method">
        <field name="name">dummy</field>
        <field name="arcaws_id" ref="arca_padron_a5"/>
        <field name="method_name">dummy</field>
        <field name="definition_dict">{}</field>
        <field name="response_dict"></field>
    </record>

    <!-- Método getPersona_v2 - Consulta datos de persona física o jurídica por CUIT -->
    <!-- NOTA: Este servicio requiere parámetros planos (token, sign, cuitRepresentada, idPersona) -->
    <!-- Método getPersonaList_v2 - Consulta datos de múltiples personas por lista de CUITs -->
    <record id="arca_constancia_inscripcion_method_get_persona_list" model="arcaws.method">
        <field name="name">get_persona_list</field>
        <field name="arcaws_id" ref="arca_padron_a5"/>
        <field name="method_name">getPersonaList_v2</field>
        <field name="definition_dict">{
    "token": connection.token,
    "sign": connection.sign,
    "cuitRepresentada": int(company_id.partner_id.ensure_vat()),
    "idPersona": [int(cuit) for cuit in extra_values.get('cuit_list', [])],
}</field>
        <field name="response_dict"></field>
    </record>


</odoo>
